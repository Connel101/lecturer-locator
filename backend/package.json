{
  "name": "lecturer-locator",
  "version": "1.0.0",
  "description": "Find any lecturer's office in seconds — just scan their QR code.",
  "homepage": "https://github.com/Connel101/lecturer-locator#readme",
  "bugs": {
    "url": "https://github.com/Connel101/lecturer-locator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Connel101/lecturer-locator.git"
  },
  "type": "module",
  "scripts": {
    "test": "tsx --test test/**/*.test.ts",
    "setup": "tsx scripts/setup.ts",
    "seed": "tsx scripts/seed.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "migrate": "npx drizzle-kit migrate",
    "generate": "auth generate --yes --output ./src/db/auth-schema.ts && drizzle-kit generate",
    "dev": "node --watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.2",
    "better-auth": "^1.7.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "auth": "^1.7.2",
    "drizzle-kit": "^1.0.0-rc.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
